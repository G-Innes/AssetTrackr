{
  "name": "assettrackr",
  "version": "1.0.0",
  "description": "Cryptocurrency portfolio tracker - Vue 3 client and Express API",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build --workspaces",
    "start": "npm run start -w server",
    "test": "npm run test --workspaces",
    "test:e2e": "npm run test:e2e -w client",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "vercel-build": "npm run build -w client",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "concurrently": "^8.2.2",
    "husky": "^9.0.11",
    "lint-staged": "^16.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "client/{src,e2e}/**/*.{ts,vue}": "prettier --write",
    "server/{src,tests}/**/*.ts": "prettier --write"
  }
}
