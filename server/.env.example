# Copy to server/.env and fill in. Never commit the real file.

NODE_ENV=development
PORT=3000

# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/assettrackr
# Managed Postgres (Neon, Render) needs TLS. Defaults to true in production.
# DATABASE_SSL=true

# A separate database for `npm test`. It is wiped on every run.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/assettrackr_test

# Required in production, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma separated origins allowed to call the API from a browser
CLIENT_ORIGIN=http://localhost:5173

# Where prices come from: "coinbase" (default, live) or "static" (fixed, offline)
# MARKET_DATA=coinbase
